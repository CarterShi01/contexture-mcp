{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CarterShi01/contexture-mcp/blob/master/spec/node-catalog.schema.json",
  "title": "Contexture Node Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "content_digest", "application", "roots", "counts", "nodes"],
  "properties": {
    "schema": {"const": "contexture.node-catalog/v1"},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "application": {"$ref": "#/$defs/application"},
    "roots": {"type": "array", "items": {"$ref": "#/$defs/ref"}, "uniqueItems": true},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "skill", "tool"],
      "properties": {
        "role": {"type": "integer", "minimum": 0},
        "skill": {"type": "integer", "minimum": 0},
        "tool": {"type": "integer", "minimum": 0}
      }
    },
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}}
  },
  "allOf": [
    {
      "if": {"properties": {"application": {"properties": {"detail": {"const": "summary"}}}}},
      "then": {"properties": {"nodes": {"items": {"properties": {
        "role": {"type": "null"}, "skill": {"type": "null"}, "tool": {"type": "null"}
      }}}}}
    },
    {
      "if": {"properties": {"application": {"properties": {"detail": {"const": "definition"}}}}},
      "then": {"properties": {"nodes": {"items": {"oneOf": [
        {"properties": {"kind": {"const": "role"}, "role": {"type": "object"}}},
        {"properties": {"kind": {"const": "skill"}, "skill": {"type": "object"}}},
        {"properties": {"kind": {"const": "tool"}, "tool": {"type": "object"}}}
      ]}}}}
    },
    {
      "if": {"properties": {"application": {"properties": {
        "detail": {"const": "definition"}, "execution_bound": {"const": true}
      }}}},
      "then": {"properties": {"nodes": {"items": {
        "if": {"properties": {"kind": {"const": "tool"}}},
        "then": {"properties": {"tool": {"properties": {"execution_available": {"const": true}}}}}
      }}}}
    },
    {
      "if": {"properties": {"application": {"properties": {
        "detail": {"const": "definition"}, "execution_bound": {"const": false}
      }}}},
      "then": {"properties": {"nodes": {"items": {
        "if": {"properties": {"kind": {"const": "tool"}}},
        "then": {"properties": {"tool": {"properties": {"execution_available": {"const": false}}}}}
      }}}}
    }
  ],
  "$defs": {
    "ref": {"type": "string", "minLength": 1, "pattern": "^[^/]+(?:/[^/]+)*$"},
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mode", "view", "detail", "locale", "execution_bound"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "mode": {"enum": ["runtime", "disclosure-only"]},
        "view": {"enum": ["application", "model", "surface"]},
        "detail": {"enum": ["summary", "definition"]},
        "locale": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "execution_bound": {"type": "boolean"}
      },
      "allOf": [{
        "if": {"properties": {"mode": {"const": "runtime"}}},
        "then": {"properties": {"execution_bound": {"const": true}}},
        "else": {"properties": {"execution_bound": {"const": false}}}
      }]
    },
    "presentation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind", "slot"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "kind": {"enum": ["role", "skill", "tool"]},
        "slot": {"enum": ["pre_process", "child", "post_process", "skill", "tool"]}
      },
      "allOf": [
        {
          "if": {"properties": {"slot": {"enum": ["pre_process", "child", "post_process"]}}},
          "then": {"properties": {"kind": {"const": "role"}}}
        },
        {
          "if": {"properties": {"slot": {"const": "skill"}}},
          "then": {"properties": {"kind": {"const": "skill"}}}
        },
        {
          "if": {"properties": {"slot": {"const": "tool"}}},
          "then": {"properties": {"kind": {"const": "tool"}}}
        }
      ]
    },
    "roleDefinition": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["authored_instructions", "effective_instructions", "pre_process_ref", "post_process_ref"],
      "properties": {
        "authored_instructions": {"type": "string", "minLength": 1},
        "effective_instructions": {"type": "string", "minLength": 1},
        "pre_process_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
        "post_process_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}
      }
    },
    "skillDefinition": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["authored_instructions", "effective_instructions"],
      "properties": {
        "authored_instructions": {"type": "string", "minLength": 1},
        "effective_instructions": {"type": "string", "minLength": 1}
      }
    },
    "toolDefinition": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["execution_available"],
          "properties": {"execution_available": {"const": false}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["execution_available", "read_only", "input_schema"],
          "properties": {
            "execution_available": {"const": true},
            "read_only": {"type": "boolean"},
            "input_schema": {"type": "object"}
          }
        }
      ]
    },
    "extensions": {
      "type": "object",
      "patternProperties": {"^[^/]+/.+$": {"type": "object"}},
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref", "kind", "name", "description", "presentation", "plane",
        "parent_ref", "ordinal", "members", "uses", "dependents",
        "role", "skill", "tool", "extensions"
      ],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "kind": {"enum": ["role", "skill", "tool"]},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "presentation": {"$ref": "#/$defs/presentation"},
        "plane": {"enum": ["model", "prompt"]},
        "parent_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
        "ordinal": {"type": "integer", "minimum": 0},
        "members": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "uses": {"type": "array", "items": {"$ref": "#/$defs/ref"}, "uniqueItems": true},
        "dependents": {"type": "array", "items": {"$ref": "#/$defs/ref"}, "uniqueItems": true},
        "role": {"$ref": "#/$defs/roleDefinition"},
        "skill": {"$ref": "#/$defs/skillDefinition"},
        "tool": {"$ref": "#/$defs/toolDefinition"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "role"}}},
          "then": {"properties": {"skill": {"type": "null"}, "tool": {"type": "null"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "skill"}}},
          "then": {"properties": {"role": {"type": "null"}, "tool": {"type": "null"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "tool"}}},
          "then": {"properties": {"role": {"type": "null"}, "skill": {"type": "null"}}}
        }
      ]
    }
  }
}
